# Copy to state/mcp.env (chmod 600). Never commit real values.
# Public URLs must match your reverse proxy exactly (see deploy/caddy/Caddyfile.example).
OAUTH_ISSUER=https://mcp.example.com/beeper/oauth
OAUTH_RESOURCE=https://mcp.example.com/beeper/mcp
OAUTH_STATE_PATH=/absolute/path/to/state/oauth.json
# confirm (default): every message needs owner approval on a protected page.
# direct: tools send immediately when the user asks (requires OAuth). Read docs/SECURITY-MODEL.md first.
BEEPER_SEND_MODE=confirm

# state/oauth-owner.env (chmod 600) is generated by:  node mcp/setup-owner.mjs state/oauth-owner.env
#   OAUTH_OWNER_PASSWORD_HASH=scrypt$...

# Optional overrides (defaults shown). BEEPER_TARGET_FILE is normally set by the systemd unit.
# MCP_PORT=8776
# BEEPER_PORT=23374
# BEEPER_TARGET_FILE=/absolute/path/to/state/beeper/targets/server.json

# Optional event forwarder: state/events.env (see mcp/EVENTS.md)
# BEEPER_WEBHOOK_URL=https://consumer.example/events
# BEEPER_WEBHOOK_SECRET=<at least 32 random bytes>
