#!/usr/bin/env python3
"""Read-only local health signals. Does not read or print message content or tokens."""
import json
import os
from pathlib import Path
import socket
import stat
import urllib.error
import urllib.request

root = Path(__file__).resolve().parent.parent
target_path = root / 'state/beeper/targets/server.json'
try:
    info = target_path.stat()
    target = json.loads(target_path.read_text())
    print('Beeper target: configured')
    print('Beeper target permissions:', 'private' if stat.S_IMODE(info.st_mode) & 0o077 == 0 else 'NOT private')
    print('Beeper target authentication:', 'present (validity not checked)' if target.get('auth', {}).get('accessToken') else 'not present')
    port = int(target.get('runtime', {}).get('port', target.get('port', 23374)))
except (OSError, ValueError, TypeError):
    print('Beeper target: unavailable or invalid')
    port = 23374

def listening(name, port):
    try:
        with socket.create_connection(('127.0.0.1', port), timeout=2):
            print(f'{name}: accepting local TCP connections on {port}')
    except OSError:
        print(f'{name}: not accepting local TCP connections on {port}')

listening('Beeper API', port)
try:
    mcp_port = int(os.environ.get('MCP_PORT', '8776'))
except ValueError:
    mcp_port = 8776
listening('MCP', mcp_port)
try:
    req = urllib.request.Request(f'http://127.0.0.1:{mcp_port}/mcp', data=b'{}', headers={'Content-Type': 'application/json'}, method='POST')
    with urllib.request.urlopen(req, timeout=2) as response:
        code = response.status
except urllib.error.HTTPError as exc:
    code = exc.code
except (OSError, ValueError):
    code = None
if code is not None:
    print('MCP unauthenticated request:', 'rejected (401)' if code == 401 else f'unexpected HTTP status {code}')
else:
    print('MCP unauthenticated request: unavailable')
print('These checks do not verify account login, message sync, HTTPS, OAuth, or end-to-end operation.')
